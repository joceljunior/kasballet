{
  "$schema": "https://railway.app/railway.schema.json",
  "$comment": "Railway configuration for Vue.js + Vite frontend",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "npx serve -s dist -l $PORT",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
